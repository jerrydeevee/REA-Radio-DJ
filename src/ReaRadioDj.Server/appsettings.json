{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:8600",

  "ReaRadioDj": {
    "StationName": "REA-Radio-DJ",
    "MusicFolder": "media/music",
    "JingleFolder": "media/jingles",
    "DataFolder": "data",
    "OutputDevice": -1,
    "StartAutomation": true,

    "Mix": {
      "TargetLufs": -16,
      "CueInDb": -40,
      "MixDb": -24,
      "CueOutDb": -50,
      "MaxOverlap": 8,
      "FadeOut": 2.5,
      "DuckLevel": 0.3
    },

    "Routing": {
      "PreviewDevice": -1,
      "MicEnabled": false,
      "MicDevice": -1,
      "MicDuckLevel": 0.25,
      "OverlayDuckLevel": 0.35,
      "StandbyPlayers": 2
    },

    "Rotation": {
      "ArtistSeparation": 3,
      "SongSeparation": 10,
      "LookAhead": 8
    },

    "Presenter": {
      "Enabled": true,
      "PresenterName": "Sam",
      "Language": "nl",
      "Persona": "Je bent een vriendelijke, energieke radiopresentator. Je praat kort en natuurlijk.",
      "MaxWords": 45,
      "Llm": {
        "BaseUrl": "",
        "Model": "",
        "ApiKey": "",
        "Temperature": 0.8,
        "TimeoutSeconds": 60
      },
      "Tts": {
        "Provider": "sapi",
        "BaseUrl": "http://localhost:8001",
        "Model": "bosonai/higgs-tts-3-4b",
        "ReferenceAudio": "",
        "ReferenceText": "",
        "Tags": "",
        "Temperature": 0.8,
        "SapiVoice": "",
        "TimeoutSeconds": 120,
        "FallbackToSapi": true,
        "ServerCommand": "wsl.exe",
        "ServerArguments": "-d Ubuntu -- bash -lc ~/higgs/start.sh",
        "ServerWorkingDirectory": "",
        "StartServer": false
      }
    },

    "Stream": {
      "Enabled": false,
      "Server": "localhost:8000/live",
      "Password": "hackme",
      "Bitrate": 128,
      "Genre": "Various",
      "Url": ""
    }
  }
}
