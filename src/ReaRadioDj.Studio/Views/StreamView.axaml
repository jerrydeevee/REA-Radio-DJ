<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReaRadioDj.Studio.ViewModels"
             x:Class="ReaRadioDj.Studio.Views.StreamView"
             x:DataType="vm:StreamTool">
  <StackPanel Margin="6" Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Ellipse Width="12" Height="12" Fill="{Binding Connected, Converter={x:Static vm:Brushes.OnAir}}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding State}" TextWrapping="Wrap" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Content="Start stream" Command="{Binding StartCommand}" />
      <Button Content="Stop stream" Command="{Binding StopCommand}" />
    </StackPanel>
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="De hoofdstream (Icecast-server, mountpoint en bitrate) staat in appsettings.json van de engine; extra servers stel je hieronder in." />
    <Expander Header="Extra streamservers" HorizontalAlignment="Stretch">
      <StackPanel Spacing="6">
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Elke server krijgt een eigen MP3-stroom met eigen kwaliteit, en de titel van wat er speelt. Icecast: host:poort/mount. SHOUTcast v1: host:poort. SHOUTcast v2: host:poort,sid. Het wachtwoord is het bronwachtwoord (of gebruiker:wachtwoord)." />
        <ItemsControl ItemsSource="{Binding Targets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StreamTargetRow">
              <Border Classes="card" Padding="6" Margin="0,0,0,4">
                <StackPanel Spacing="4">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="small" Content="✕" Margin="4,0,0,0"
                            Command="{Binding $parent[ItemsControl].DataContext.RemoveTargetCommand}" CommandParameter="{Binding}" />
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" ToolTip.Tip="Aan of uit" />
                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                             Fill="{Binding Connected, Converter={x:Static vm:Brushes.OnAir}}" />
                    <TextBox DockPanel.Dock="Left" Width="140" Text="{Binding Name}" Watermark="naam" />
                    <TextBlock Classes="muted" Text="{Binding StateText}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <WrapPanel>
                    <TextBox Width="260" Text="{Binding Server}" Watermark="stream.example.nl:8000/hoog" Margin="0,0,4,0" />
                    <TextBox Width="160" Text="{Binding Password}" PasswordChar="•" Watermark="bronwachtwoord" Margin="0,0,4,0" />
                    <ComboBox Width="90" ItemsSource="{Binding $parent[ItemsControl].DataContext.Bitrates}" SelectedItem="{Binding Bitrate}" />
                    <TextBlock Text="kbit/s MP3" VerticalAlignment="Center" Margin="4,0,0,0" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="small" Content="+ server" Command="{Binding AddTargetCommand}" />
          <Button Content="Opslaan" Command="{Binding SaveTargetsCommand}" />
          <Button Classes="small" Content="Ververs" Command="{Binding RefreshTargetsCommand}" />
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding TargetStatus}" TextWrapping="Wrap" />
      </StackPanel>
    </Expander>
    <Expander Header="Titel en programmalog als tekst" HorizontalAlignment="Stretch">
      <StackPanel Spacing="6">
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Velden: {artiest} {titel} {categorie} {type} {bron} {duur} {tijd} {datum} {station}. De titel gaat naar de stream, een tekstbestand (website, RDS) en een webadres; alleen de log verandert de titel, cartwall en overlays niet." />
        <TextBlock Text="Titel" FontWeight="SemiBold" />
        <TextBox Text="{Binding TitleFormat}" Watermark="{}{artiest} - {titel}" />
        <WrapPanel>
          <TextBlock Text="Eigen titel voor:" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ItemsControl ItemsSource="{Binding TitleKinds}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StreamTool+KindChoice">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" Margin="0,0,8,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>
        <TextBox Text="{Binding TitleOther}" Watermark="tijdens de rest (leeg = laatste titel blijft staan), bijv. {station}" />
        <TextBox Text="{Binding TitleFile}" Watermark="tekstbestand met de titel van nu, bijv. C:\Uitzending\nu.txt (leeg = uit)" />
        <TextBox Text="{Binding TitleUrl}" Watermark="webadres, bijv. http://rds.local/set?text={tekst} (leeg = uit)" />
        <TextBlock Text="Programmalog als tekst" FontWeight="SemiBold" Margin="0,4,0,0" />
        <TextBox Text="{Binding LogFolder}" Watermark="map, één bestand per dag (leeg = uit)" />
        <TextBox Text="{Binding LogFormat}" Watermark="{}{tijd}\t{type}\t{artiest} - {titel}\t{duur}" ToolTip.Tip="\t is een tab" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Bewaren" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding LogKeepDays}" Minimum="0" Maximum="3650" Increment="30" Width="130" FormatString="0" />
          <TextBlock Text="dagen (0 = altijd)" VerticalAlignment="Center" Classes="muted" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Bewaren" Command="{Binding SaveTitleLogCommand}" />
          <Button Content="Testen" Command="{Binding TestTitleLogCommand}" ToolTip.Tip="Bewaart en stuurt een testtitel naar bestand en webadres" />
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding TitleLogText}" TextWrapping="Wrap" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
