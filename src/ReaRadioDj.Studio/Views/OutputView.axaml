<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReaRadioDj.Studio.ViewModels"
             xmlns:ctl="using:ReaRadioDj.Studio.Controls"
             x:Class="ReaRadioDj.Studio.Views.OutputView"
             x:DataType="vm:OutputTool">
  <!-- Uitsturing: the program on the left, then one large meter per mixer channel with its open lamp. The meters grow
       with the window, so it can stand on a separate screen and be read from across the studio. -->
  <DockPanel Margin="8">
    <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding OpenSummary}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
               ToolTip.Tip="Kanalen die nu naar de zender gaan (aan, niet gedempt, fader open)" />

    <!-- program -->
    <Border DockPanel.Dock="Left" Classes="card" Padding="8" Margin="0,0,8,0" Width="150">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Programma" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="11" Text="zender" HorizontalAlignment="Center" Margin="0,0,0,6" />
        <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,6,0,0">
          <TextBlock Classes="mono" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding ProgramPeak, StringFormat='{}{0} dB'}"
                     ToolTip.Tip="Piek van het programma (dBFS)" />
          <TextBlock Classes="mono muted" FontSize="11" HorizontalAlignment="Center" ToolTip.Tip="Loudness kort (3 s) en geïntegreerd, EBU R128">
            <Run Text="{Binding Lufs}" /><Run Text=" / " /><Run Text="{Binding LufsIntegrated}" /><Run Text=" LUFS" />
          </TextBlock>
          <TextBlock Classes="mono muted" FontSize="11" HorizontalAlignment="Center" Text="{Binding TruePeak, StringFormat='true peak {0} dBTP'}" />
          <Border Background="#F5A524" CornerRadius="{DynamicResource Radius3}" Padding="6,1" HorizontalAlignment="Center" IsVisible="{Binding Limiter}"
                  ToolTip.Tip="De begrenzer op de zender staat aan">
            <TextBlock Text="BEGRENZER" FontSize="10" FontWeight="Bold" Foreground="#11161D" />
          </Border>
        </StackPanel>
        <ctl:LevelMeter Orientation="Vertical" ShowScale="True" Left="{Binding ProgramLeft}" Right="{Binding ProgramRight}"
                        HorizontalAlignment="Stretch" Margin="18,0" />
      </DockPanel>
    </Border>

    <!-- one column per channel; all columns share the width and take the full height -->
    <ItemsControl ItemsSource="{Binding Channels}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:OutputChannelVm">
          <Border Classes="card" Padding="6" Margin="0,0,6,0" MinWidth="64" ToolTip.Tip="{Binding Tip}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="10" Text="{Binding Route}" HorizontalAlignment="Center" />
              <!-- lamp: lit while the channel goes to the transmitter -->
              <Border DockPanel.Dock="Top" Background="{Binding LampBrush}" CornerRadius="{DynamicResource Radius3}" Padding="4,2" Margin="0,4,0,6">
                <TextBlock Text="{Binding LampText}" FontSize="11" FontWeight="Bold" Foreground="{Binding LampTextBrush}" HorizontalAlignment="Center" />
              </Border>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" Margin="0,6,0,0">
                <Ellipse Width="8" Height="8" Fill="{Binding Signal}" VerticalAlignment="Center" ToolTip.Tip="Er komt geluid binnen" />
                <TextBlock Classes="mono" FontSize="13" FontWeight="Bold" Text="{Binding Peak}" VerticalAlignment="Center" />
              </StackPanel>
              <ctl:LevelMeter Orientation="Vertical" ShowScale="True" Left="{Binding Left}" Right="{Binding Right}" Width="40" HorizontalAlignment="Center" />
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
