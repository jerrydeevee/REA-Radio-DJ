<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReaRadioDj.Studio.ViewModels"
             xmlns:v="using:ReaRadioDj.Studio.Views"
             xmlns:ctl="using:ReaRadioDj.Studio.Controls"
             x:Class="ReaRadioDj.Studio.Views.DjView"
             x:DataType="vm:DjTool">
  <DockPanel Margin="8">
    <!-- What the listener hears: the automation or this desk -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="12,6" Margin="0,0,0,6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <Border Grid.Column="0" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius8}" ClipToBounds="True" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <ToggleButton Classes="seg" Content="Alleen PFL" IsChecked="{Binding !OnAir, Mode=OneWay}" Command="{Binding SetOnAirCommand}" CommandParameter="off"
                          ToolTip.Tip="De DJ-tafel gaat niet de zender op; de automatisering is hoorbaar" />
            <ToggleButton Classes="seg onair" Content="DJ ON AIR" IsChecked="{Binding OnAir, Mode=OneWay}" Command="{Binding SetOnAirCommand}" CommandParameter="on"
                          ToolTip.Tip="Wat je mixt gaat de zender op. De automatisering loopt onhoorbaar mee, zodat je hem met één knop terug kunt geven." />
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="1" Classes="muted" FontSize="13" Text="{Binding OnAirText}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Classes="bar" MinHeight="36" Content="Volg de zender op deck A" Command="{Binding FollowCommand}" Margin="0,0,12,0"
                IsVisible="{Binding CanFollow}" ToolTip.Tip="Deck A speelt mee met wat de automatisering uitzendt, zodat je naadloos kunt overnemen. Deck A moet leeg zijn." />
        <TextBlock Grid.Column="2" Foreground="{DynamicResource WarnBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding !Available}"
                   Text="Deze engine heeft nog geen DJ-tafel: werk de engine bij" />
        <ToggleButton Grid.Column="3" Classes="bar" MinHeight="36" Margin="0,0,12,0" Content="{Binding RecordText}" IsChecked="{Binding Recording, Mode=OneWay}"
                      Command="{Binding ToggleRecordCommand}" IsVisible="{Binding Available}"
                      ToolTip.Tip="Neemt op wat de DJ-tafel mixt, ON AIR en OFF AIR. Na stoppen staat de mix in de bibliotheek bij Opnamen." />
        <Border Grid.Column="4" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius8}" ClipToBounds="True" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <ToggleButton Classes="seg" Content="2 decks" IsChecked="{Binding !FourDecks, Mode=OneWay}" Command="{Binding SetDecksCommand}" CommandParameter="2" />
            <ToggleButton Classes="seg" Content="4 decks" IsChecked="{Binding FourDecks, Mode=OneWay}" Command="{Binding SetDecksCommand}" CommandParameter="4" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- On air: the automation runs on unheard; one button gives the broadcast back -->
    <Border DockPanel.Dock="Top" Classes="shadow" IsVisible="{Binding Shadow}" Padding="12,8" Margin="0,0,0,8"
            CornerRadius="{DynamicResource Radius10}" BorderThickness="2" BorderBrush="{DynamicResource WarnBrush}" Background="#33F5A524">
      <Border.Styles>
        <Style Selector="Border.shadow">
          <Style.Animations>
            <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate">
              <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
              <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.72" /></KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
      </Border.Styles>
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="bar" MinHeight="40" FontWeight="Bold" Content="↩ Teruggeven aan automatisering"
                Command="{Binding GiveBackCommand}" VerticalAlignment="Center"
                ToolTip.Tip="De DJ-tafel gaat van de lucht en de automatisering is meteen hoorbaar, op de plek waar hij nu is" />
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0" Spacing="2">
          <TextBlock Text="{Binding ShadowText}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding ShadowNext}" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding ShadowNext, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- All decks as scrolling waveforms above each other: synced beats line up under the playhead -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="0" Margin="0,0,0,8" ClipToBounds="True" IsVisible="{Binding Available}">
      <ctl:DjTwinWave Decks="{Binding Decks}" Count="{Binding DeckCount}" Height="{Binding DeckCount, Converter={x:Static vm:Brushes.TwinWaveHeight}}"
                      ToolTip.Tip="Golfvormen van de decks met beatstrepen (dik = elke vierde tel). Draai aan het muiswiel om in of uit te zoomen." />
    </Border>

    <!-- With four decks everything is scaled down a little when needed, so it fits without scrolling (down to 70 %). -->
    <ctl:FitToHeight Enabled="{Binding FourDecks}" MinScale="0.7">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid ColumnDefinitions="*,8,Auto,8,*" RowDefinitions="Auto,Auto">
        <v:DjDeckView Grid.Row="0" Grid.Column="0" DataContext="{Binding A}" />
        <v:DjDeckView Grid.Row="0" Grid.Column="4" DataContext="{Binding B}" />
        <Panel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" IsVisible="{Binding FourDecks}"><v:DjDeckView DataContext="{Binding C}" /></Panel>
        <Panel Grid.Row="1" Grid.Column="4" Margin="0,8,0,0" IsVisible="{Binding FourDecks}"><v:DjDeckView DataContext="{Binding D}" /></Panel>

        <!-- Mixer -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Classes="card" Padding="14,12" CornerRadius="{DynamicResource Radius10}" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="220,16,220" IsVisible="{Binding !FourDecks}">
              <v:DjStripView Grid.Column="0" DataContext="{Binding A}" />
              <v:DjStripView Grid.Column="2" DataContext="{Binding B}" />
            </Grid>
            <!-- Four decks: the strips side by side as on a four-deck controller, C A | B D (left of the crossfader A and C) -->
            <Grid ColumnDefinitions="214,10,214,16,214,10,214" IsVisible="{Binding FourDecks}">
              <v:DjStripView Grid.Column="0" DataContext="{Binding C}" />
              <v:DjStripView Grid.Column="2" DataContext="{Binding A}" />
              <v:DjStripView Grid.Column="4" DataContext="{Binding B}" />
              <v:DjStripView Grid.Column="6" DataContext="{Binding D}" />
            </Grid>
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="lbl" Text="A" Foreground="#4C8DFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Grid.Column="1" Classes="small" Content="Midden" Command="{Binding CenterCrossfaderCommand}" ToolTip.Tip="Crossfader naar het midden" />
                <TextBlock Grid.Column="2" Classes="lbl" Text="CROSSFADER" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="3" Classes="small" Content="Scherp" IsChecked="{Binding Sharp, Mode=OneWay}" Command="{Binding ToggleCurveCommand}"
                              FontSize="12" Padding="10,3"
                              ToolTip.Tip="Uit: vloeiende overgang. Aan: beide kanten blijven open tot vlak voor het einde (knippen, scratchen)." />
                <TextBlock Grid.Column="4" Classes="lbl" Text="B" Foreground="#F5A524" VerticalAlignment="Center" Margin="10,0,0,0" />
              </Grid>
              <Slider Minimum="0" Maximum="100" Value="{Binding Crossfader}" ToolTip.Tip="Links: decks A en C. Rechts: decks B en D." />
            </StackPanel>
            <!-- Headphones: a knob from cue to master, quantize and the limiter on the DJ output -->
            <Grid ColumnDefinitions="Auto,*">
              <ctl:Knob Grid.Column="0" Width="44" Height="44" Minimum="0" Maximum="100" Default="50" Value="{Binding CueMix}" Margin="0,0,10,0" VerticalAlignment="Center"
                        ToolTip.Tip="Koptelefoon. Links: alleen de decks met PFL. Midden: allebei. Rechts: alleen de mix van de tafel. Dubbelklik = midden." />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="lbl" Text="KOPTELEFOON · CUE ↔ MASTER" />
                <Grid ColumnDefinitions="*,6,*,6,*">
                  <Button Grid.Column="0" Classes="small" Content="Alleen cue" Command="{Binding CueOnlyCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  <ToggleButton Grid.Column="2" Classes="small" Content="Quantize" IsChecked="{Binding Quantize, Mode=OneWay}" Command="{Binding ToggleQuantizeCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                ToolTip.Tip="Hot cues, loops en rolls vallen op de tel; een sprong naar een hot cue blijft in de maat" />
                  <ToggleButton Grid.Column="4" Classes="small" Content="Begrenzer" IsChecked="{Binding Limiter, Mode=OneWay}" Command="{Binding ToggleLimiterCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                ToolTip.Tip="Begrenzer op de DJ-uitgang (-1 dBFS): de mix komt nooit boven het plafond, ook in de opname" />
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
    </ctl:FitToHeight>
  </DockPanel>
</UserControl>
