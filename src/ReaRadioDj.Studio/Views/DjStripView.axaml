<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReaRadioDj.Studio.ViewModels"
             xmlns:ctl="using:ReaRadioDj.Studio.Controls"
             x:Class="ReaRadioDj.Studio.Views.DjStripView"
             x:DataType="vm:DjDeckVm">
  <!-- The mixer channel of one deck: knobs for gain, filter and the equaliser with kills on the left, fader with level on the right -->
  <StackPanel Spacing="8">
    <TextBlock Classes="lbl" Foreground="{Binding Brush}" HorizontalAlignment="Center">
      <Run Text="DECK " /><Run Text="{Binding Id}" />
    </TextBlock>
    <Grid ColumnDefinitions="*,12,Auto">
      <StackPanel Grid.Column="0" Spacing="10">
        <UniformGrid Columns="3">
        <StackPanel Spacing="2" HorizontalAlignment="Center">
          <ctl:Knob Width="46" Height="46" Minimum="-12" Maximum="12" Value="{Binding Gain}" ArcBrush="{Binding Brush}" HorizontalAlignment="Center" ToolTip.Tip="Voorversterking, -12 tot +12 dB. Slepen of muiswiel; dubbelklik = midden." />
          <TextBlock Text="Gain" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Spacing="2" HorizontalAlignment="Center">
          <ctl:Knob Width="46" Height="46" Minimum="-1" Maximum="1" Value="{Binding Filter}" ArcBrush="{Binding Brush}" HorizontalAlignment="Center" ToolTip.Tip="Links: alleen het laag blijft over. Midden: uit. Rechts: alleen het hoog blijft over. Slepen of muiswiel; dubbelklik = midden." />
          <TextBlock Text="Filter" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>
          <Button Classes="kill" Content="EQ 0" VerticalAlignment="Center" HorizontalAlignment="Center" Command="{Binding ResetEqCommand}" ToolTip.Tip="Equalizer en filter terug naar het midden" />
        </UniformGrid>
        <UniformGrid Columns="3">
        <StackPanel Spacing="2" HorizontalAlignment="Center">
          <ctl:Knob Width="46" Height="46" Minimum="-1" Maximum="1" Value="{Binding EqHigh}" ArcBrush="{Binding Brush}" Muted="{Binding KillHigh}" HorizontalAlignment="Center" ToolTip.Tip="Hoog. Slepen of muiswiel; dubbelklik = midden." />
          <TextBlock Text="Hoog" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <ToggleButton Classes="kill" Content="Kill" HorizontalAlignment="Center" IsChecked="{Binding KillHigh, Mode=OneWay}" Command="{Binding KillCommand}" CommandParameter="high" ToolTip.Tip="Hoog helemaal weg" />
        </StackPanel>
        <StackPanel Spacing="2" HorizontalAlignment="Center">
          <ctl:Knob Width="46" Height="46" Minimum="-1" Maximum="1" Value="{Binding EqMid}" ArcBrush="{Binding Brush}" Muted="{Binding KillMid}" HorizontalAlignment="Center" ToolTip.Tip="Midden. Slepen of muiswiel; dubbelklik = midden." />
          <TextBlock Text="Midden" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <ToggleButton Classes="kill" Content="Kill" HorizontalAlignment="Center" IsChecked="{Binding KillMid, Mode=OneWay}" Command="{Binding KillCommand}" CommandParameter="mid" ToolTip.Tip="Midden helemaal weg" />
        </StackPanel>
        <StackPanel Spacing="2" HorizontalAlignment="Center">
          <ctl:Knob Width="46" Height="46" Minimum="-1" Maximum="1" Value="{Binding EqLow}" ArcBrush="{Binding Brush}" Muted="{Binding KillLow}" HorizontalAlignment="Center" ToolTip.Tip="Laag. Slepen of muiswiel; dubbelklik = midden." />
          <TextBlock Text="Laag" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <ToggleButton Classes="kill" Content="Kill" HorizontalAlignment="Center" IsChecked="{Binding KillLow, Mode=OneWay}" Command="{Binding KillCommand}" CommandParameter="low" ToolTip.Tip="Laag helemaal weg" />
        </StackPanel>
        </UniformGrid>
      </StackPanel>
      <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,Auto" Height="168">
        <Slider Grid.Column="0" Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding Fader}" ToolTip.Tip="Kanaalfader" />
        <ProgressBar Grid.Column="1" Orientation="Vertical" Value="{Binding LevelLeft}" Maximum="100" MinWidth="8" Width="8" MinHeight="0" Foreground="{DynamicResource OkBrush}" Margin="4,8,3,8" />
        <ProgressBar Grid.Column="2" Orientation="Vertical" Value="{Binding LevelRight}" Maximum="100" MinWidth="8" Width="8" MinHeight="0" Foreground="{DynamicResource OkBrush}" Margin="0,8" />
      </Grid>
    </Grid>
    <ToggleButton Classes="bar" IsChecked="{Binding Pfl, Mode=OneWay}" Command="{Binding TogglePflCommand}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" ToolTip.Tip="Dit deck op de koptelefoon (PFL), ook met de fader dicht">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Path Data="M2,13 V8 A6,6 0 0 1 14,8 V13 M1,8 H4 V13 H1 Z M12,8 H15 V13 H12 Z" Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.6"
              Width="16" Height="14" Stretch="None" VerticalAlignment="Center" />
        <TextBlock Text="PFL" VerticalAlignment="Center" />
      </StackPanel>
    </ToggleButton>
  </StackPanel>
</UserControl>
