<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReaRadioDj.Studio.ViewModels"
             xmlns:c="using:ReaRadioDj.Contracts"
             x:Class="ReaRadioDj.Studio.Views.AsRunView"
             x:DataType="vm:AsRunTool">
  <DockPanel Margin="6">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
        <Button Classes="small" Content="Vernieuwen" Command="{Binding LoadCommand}" />
        <Button Classes="small" x:Name="Export" Content="Exporteer CSV…" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CalendarDatePicker SelectedDate="{Binding Day}" />
        <ComboBox ItemsSource="{Binding Presenters}" SelectedItem="{Binding Presenter}" MinWidth="170"
                  ToolTip.Tip="Wie was aangemeld in de studio toen het item uitgezonden werd" />
        <TextBlock Classes="muted" Text="{Binding Summary}" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,6,0,0">
      <StackPanel Spacing="4">
        <TextBlock FontWeight="SemiBold" Text="Muziekrapport (Buma/Stemra · Sena)" />
        <WrapPanel>
          <TextBlock Classes="muted" Text="van" VerticalAlignment="Center" Margin="0,0,4,4" />
          <CalendarDatePicker SelectedDate="{Binding ReportFrom}" Margin="0,0,8,4" />
          <TextBlock Classes="muted" Text="t/m" VerticalAlignment="Center" Margin="0,0,4,4" />
          <CalendarDatePicker SelectedDate="{Binding ReportTo}" Margin="0,0,8,4" />
          <Button Classes="small" x:Name="Report" Content="Muziekrapport…" Margin="0,0,4,4"
                  ToolTip.Tip="Elke uitzending van een nummer: datum, tijd, duur, uitvoerende, titel, componist, label, ISRC" />
          <Button Classes="small" x:Name="ReportSum" Content="Overzicht per nummer…" Margin="0,0,4,4"
                  ToolTip.Tip="Per nummer: aantal keer gedraaid en totale duur" />
          <Button Classes="small" x:Name="ReportPdf" Content="Rapport als PDF…" Margin="8,0,4,4"
                  ToolTip.Tip="Hetzelfde muziekrapport als PDF, om te printen of mee te sturen" />
          <Button Classes="small" x:Name="ReportSumPdf" Content="Overzicht als PDF…" Margin="0,0,4,4"
                  ToolTip.Tip="Het overzicht per nummer als PDF" />
        </WrapPanel>
        <TextBlock Classes="muted" Text="{Binding ReportSummary}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ListBox ItemsSource="{Binding Entries}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="c:AsRunDto">
          <Grid ColumnDefinitions="70,90,64,*,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Started, StringFormat='{}{0:HH:mm:ss}'}" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="{Binding Type, Converter={x:Static vm:Brushes.TypeColor}}" />
            <TextBlock Grid.Column="3" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Artist}" /><Run Text=" - " /><Run Text="{Binding Title}" />
            </TextBlock>
            <TextBlock Grid.Column="4" Classes="muted" Text="{Binding Presenter}" Margin="8,0,0,0" MaxWidth="120" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="5" Classes="mono muted" Text="{Binding Played, StringFormat='{}{0:0}s', TargetNullValue=''}" Margin="6,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
