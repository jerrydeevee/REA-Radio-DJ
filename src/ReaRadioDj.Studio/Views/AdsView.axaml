<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReaRadioDj.Studio.ViewModels"
             xmlns:c="using:ReaRadioDj.Contracts"
             x:Class="ReaRadioDj.Studio.Views.AdsView"
             x:DataType="vm:AdsTool">
  <TabControl Classes="compact" Margin="4">
    <!-- ============================================================ campaigns -->
    <TabItem Header="Campagnes">
      <Grid ColumnDefinitions="170,*">
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
          <Button DockPanel.Dock="Bottom" Classes="small" Content="Nieuwe campagne" Command="{Binding NewCampaignCommand}" Margin="0,4,0,0" HorizontalAlignment="Stretch" />
          <ListBox ItemsSource="{Binding Campaigns}" SelectedItem="{Binding Campaign}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="c:AdCampaignDto">
                <StackPanel Opacity="{Binding Enabled, Converter={x:Static vm:Brushes.EnabledOpacity}}">
                  <TextBlock Text="{Binding Advertiser}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock FontSize="11">
                    <Run Text="vandaag " /><Run Text="{Binding Today}" /><Run Text=" / " /><Run Text="{Binding PerDay}" />
                  </TextBlock>
                  <TextBlock Foreground="#F0B429" FontSize="11" TextWrapping="Wrap" Text="{Binding Status}"
                             IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="6">
            <Border Classes="card">
              <StackPanel Spacing="5">
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" Content="Actief" IsChecked="{Binding CampaignEnabled}" Margin="8,0,0,0" />
                  <TextBox Text="{Binding Advertiser}" Watermark="adverteerder, bijv. Bakkerij De Vries" />
                </DockPanel>
                <TextBox Text="{Binding CampaignName}" Watermark="campagne, bijv. Najaarsactie (leeg = naam adverteerder)" />
                <WrapPanel>
                  <TextBlock Text="van" VerticalAlignment="Center" Margin="0,0,6,4" />
                  <CalendarDatePicker SelectedDate="{Binding Start}" FirstDayOfWeek="Monday" Margin="0,0,10,4" />
                  <TextBlock Text="t/m" VerticalAlignment="Center" Margin="0,0,6,4" />
                  <CalendarDatePicker SelectedDate="{Binding End}" FirstDayOfWeek="Monday" Margin="0,0,0,4" />
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding CampaignDays}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayChoice">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding On}" MinWidth="44" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel>
                  <TextBlock Text="uren" VerticalAlignment="Center" Margin="0,0,6,4" />
                  <TextBox Text="{Binding CampaignHours}" Width="110" Margin="0,0,12,4" ToolTip.Tip="* = elk uur, of bijv. 7-9,16-19" />
                  <NumericUpDown Value="{Binding PerDay}" Minimum="1" Maximum="200" Increment="1" FormatString="0" Width="100" Margin="0,0,6,4" />
                  <TextBlock Text="per dag," VerticalAlignment="Center" Margin="0,0,10,4" />
                  <TextBlock Text="hoogstens" VerticalAlignment="Center" Margin="0,0,6,4" />
                  <NumericUpDown Value="{Binding PerHour}" Minimum="1" Maximum="12" Increment="1" FormatString="0" Width="90" Margin="0,0,6,4" />
                  <TextBlock Text="per uur" VerticalAlignment="Center" Margin="0,0,0,4" />
                </WrapPanel>
                <ComboBox ItemsSource="{Binding Positions}" SelectedIndex="{Binding Position}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="5">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="small" Content="+ Selectie uit bibliotheek" Command="{Binding AddSpotCommand}" />
                  <TextBlock Classes="h" Text="Spots (wisselen elkaar af)" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Spots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="c:AdSpotDto">
                      <DockPanel Margin="0,1">
                        <Button DockPanel.Dock="Right" Classes="small" Content="✕" ToolTip.Tip="Spot weghalen"
                                Command="{Binding $parent[UserControl].DataContext.RemoveSpotCommand}" CommandParameter="{Binding}" />
                        <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Length, StringFormat='{}{0:0} s'}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding Notes}" Watermark="notities (contactpersoon, ordernummer)" AcceptsReturn="True" MinHeight="40" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <WrapPanel>
              <Button Classes="small go" Content="Opslaan" Command="{Binding SaveCampaignCommand}" Margin="0,0,4,4" />
              <Button Classes="small" Content="Verwijderen" Command="{Binding DeleteCampaignCommand}" Margin="0,0,4,4" />
            </WrapPanel>
            <TextBlock Foreground="#F25F5C" TextWrapping="Wrap" Text="{Binding CampaignError}" IsVisible="{Binding CampaignError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                       Text="De reclameblokken worden 3 minuten vooraf gevuld: eerst de campagnes die het verst achterlopen op hun aantal per dag, nooit twee spots van dezelfde adverteerder in één blok, en nooit langer dan het blok mag duren. Een spot speelt altijd helemaal uit." />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <!-- ============================================================ breaks -->
    <TabItem Header="Blokken">
      <Grid ColumnDefinitions="170,*">
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
          <Button DockPanel.Dock="Bottom" Classes="small" Content="Nieuw reclameblok" Command="{Binding NewBreakCommand}" Margin="0,4,0,0" HorizontalAlignment="Stretch" />
          <ListBox ItemsSource="{Binding Breaks}" SelectedItem="{Binding Break}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="c:AdBreakDto">
                <StackPanel Opacity="{Binding Enabled, Converter={x:Static vm:Brushes.EnabledOpacity}}">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding When}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding Next, StringFormat='volgende: {0:ddd HH:mm}'}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="6">
            <Border Classes="card">
              <StackPanel Spacing="5">
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" Content="Actief" IsChecked="{Binding BreakEnabled}" Margin="8,0,0,0" />
                  <TextBox Text="{Binding BreakName}" Watermark="naam, bijv. Reclame :25" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding BreakDays}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayChoice">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding On}" MinWidth="44" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel>
                  <TextBlock Text="uren" VerticalAlignment="Center" Margin="0,0,6,4" />
                  <TextBox Text="{Binding BreakHours}" Width="110" Margin="0,0,12,4" ToolTip.Tip="* = elk uur, of bijv. 7-19" />
                  <TextBlock Text="minuut" VerticalAlignment="Center" Margin="0,0,6,4" />
                  <NumericUpDown Value="{Binding Minute}" Minimum="0" Maximum="59" Increment="1" FormatString="0" Width="100" Margin="0,0,8,4" />
                  <TextBlock Text="sec" VerticalAlignment="Center" Margin="0,0,6,4" />
                  <NumericUpDown Value="{Binding Second}" Minimum="0" Maximum="59" Increment="1" FormatString="0" Width="100" Margin="0,0,0,4" />
                </WrapPanel>
                <ComboBox ItemsSource="{Binding Timings}" SelectedIndex="{Binding Timing}" HorizontalAlignment="Stretch" />
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Opener" Width="70" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Jingles}" SelectedItem="{Binding Opener}" HorizontalAlignment="Stretch" />
                </DockPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Sluiter" Width="70" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Jingles}" SelectedItem="{Binding Closer}" HorizontalAlignment="Stretch" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="spots samen hoogstens" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding MaxSeconds}" Minimum="10" Maximum="900" Increment="15" FormatString="0" Width="110" />
                  <TextBlock Text="seconden" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
            <WrapPanel>
              <Button Classes="small go" Content="Opslaan" Command="{Binding SaveBreakCommand}" Margin="0,0,4,4" />
              <Button Classes="small" Content="Test: wat komt erin?" Command="{Binding PreviewBreakCommand}" Margin="0,0,4,4" />
              <Button Classes="small" Content="Verwijderen" Command="{Binding DeleteBreakCommand}" Margin="0,0,4,4" />
            </WrapPanel>
            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                       Text="Zacht: het blok komt na het lopende nummer (aanbevolen voor reclame). Heeft geen enkele campagne een spot nodig, dan wordt het hele blok overgeslagen, dus ook geen opener of sluiter." />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <!-- ============================================================ proof of broadcast -->
    <TabItem Header="Uitzendbewijs">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="van" VerticalAlignment="Center" Margin="0,0,6,4" />
          <CalendarDatePicker SelectedDate="{Binding ProofFrom}" FirstDayOfWeek="Monday" Margin="0,0,8,4" />
          <TextBlock Text="t/m" VerticalAlignment="Center" Margin="0,0,6,4" />
          <CalendarDatePicker SelectedDate="{Binding ProofTo}" FirstDayOfWeek="Monday" Margin="0,0,8,4" />
          <ComboBox ItemsSource="{Binding ProofCampaigns}" SelectedItem="{Binding ProofCampaign}" MinWidth="200" Margin="0,0,8,4" />
          <Button Classes="small" Content="Vernieuwen" Command="{Binding LoadProofCommand}" Margin="0,0,4,4" />
          <Button Classes="small go" x:Name="Export" Content="Uitzendbewijs CSV…" Margin="0,0,4,4" ToolTip.Tip="Elke uitzending apart" />
          <Button Classes="small" x:Name="ExportReport" Content="Overzicht CSV…" Margin="0,0,4,4" ToolTip.Tip="Totalen per adverteerder en campagne" />
          <Button Classes="small" x:Name="ExportJson" Content="JSON…" Margin="0,0,4,4" ToolTip.Tip="Overzicht en alle uitzendingen in één bestand, om te koppelen" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ProofSummary}" Margin="0,0,0,4" />
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Report}" Margin="0,0,0,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="c:AdReportLineDto">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Advertiser}" FontWeight="SemiBold" /><Run Text=" – " /><Run Text="{Binding Campaign}" /></TextBlock>
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Text}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ListBox ItemsSource="{Binding Plays}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="c:AdPlayDto">
              <Grid ColumnDefinitions="110,*,70,90">
                <TextBlock Grid.Column="0" Text="{Binding Scheduled, StringFormat='{}{0:dd-MM HH:mm}'}" VerticalAlignment="Center" FontFamily="Consolas" />
                <StackPanel Grid.Column="1">
                  <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Advertiser}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Spot}" />
                  </TextBlock>
                  <TextBlock Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Campaign}" /><Run Text=" · " /><Run Text="{Binding Break}" />
                  </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Played, StringFormat='{}{0:0} s', TargetNullValue='—'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding ., Converter={x:Static vm:AdsTool.StatusText}}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>
