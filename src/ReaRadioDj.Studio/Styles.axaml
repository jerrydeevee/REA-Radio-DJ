<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:ReaRadioDj.Studio.Controls">
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.h">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.onair">
    <Setter Property="Background" Value="{DynamicResource OnAirBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.mic:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OnAirBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- Transport: big enough to hit with a finger in a hurry (44 px), clear colours: green = go, red = stop -->
  <Style Selector=":is(Button).transport">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.transport.go">
    <Setter Property="Background" Value="#2F9E6A" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.transport.stop">
    <Setter Property="Background" Value="#7A1F25" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.view">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinWidth" Value="104" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.view:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#0B0F14" />
  </Style>

  <!-- Countdown of the item on air: runs empty, amber in the last 20 s, red and flashing in the last 10 s -->
  <Style Selector="ProgressBar.countdown">
    <Setter Property="Foreground" Value="#3DBD7D" />
    <Setter Property="Background" Value="#1A2029" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ProgressBar.countdown.warn">
    <Setter Property="Foreground" Value="#F0B429" />
  </Style>
  <Style Selector="ProgressBar.countdown.end">
    <Setter Property="Foreground" Value="#E5484D" />
  </Style>
  <Style Selector="ProgressBar.countdown.end.flash">
    <Setter Property="Background" Value="#5A1A1E" />
  </Style>
  <Style Selector="TextBlock.remaining.warn">
    <Setter Property="Foreground" Value="#F0B429" />
  </Style>
  <Style Selector="TextBlock.remaining.end">
    <Setter Property="Foreground" Value="#E5484D" />
  </Style>

  <!-- App bar and on-air bar. Rules of the layout design: one filled button per area (Volgende), everything you
       press at least 44 px high, labels small and in capitals, counters in monospace. -->
  <Style Selector="TextBlock.lbl">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="Border.key">
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.key > TextBlock">
    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector=":is(Button).bar">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.bar.primary">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.bar.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#3B76F0" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.bar.primary Border.key">
    <Setter Property="BorderBrush" Value="#6E9BF5" />
  </Style>
  <Style Selector="Button.bar.primary Border.key > TextBlock">
    <Setter Property="Foreground" Value="#DCE7FF" />
  </Style>
  <Style Selector="Button.bar.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource OnAirBrush}" />
    <Setter Property="Foreground" Value="#FF9B9E" />
  </Style>
  <Style Selector="Button.bar.danger.holding /template/ ContentPresenter">
    <Setter Property="Background" Value="#7A1F25" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.bar:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.bar.mic:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OnAirBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- DJ desk -->
  <Style Selector=":is(Button).bar.big">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="ToggleButton.bar.play:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#1B3155" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.pad">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="#141920" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#6B7684" />
  </Style>
  <Style Selector="Button.pad.filled">
    <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector=":is(Button).kill">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.kill:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
    <Setter Property="Foreground" Value="#1A1206" />
  </Style>
  <Style Selector="ToggleButton.seg.onair:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#C42B30" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- Two halves of one switch -->
  <Style Selector="ToggleButton.seg">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <!-- Workspace tabs in the app bar: the chosen one has a line under it -->
  <Style Selector="ToggleButton.nav">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ctl|OnAirProgress.warn">
    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="ctl|OnAirProgress.end">
    <Setter Property="Fill" Value="{DynamicResource OnAirBrush}" />
  </Style>
  <Style Selector="ctl|OnAirProgress.end.flash">
    <Setter Property="Track" Value="#5A1A1E" />
  </Style>
  <Style Selector="TextBlock.remaining.warn">
    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
  </Style>

  <Style Selector="TabControl.compact > TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
</Styles>
