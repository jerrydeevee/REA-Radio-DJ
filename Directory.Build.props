<Project>
  <!-- Shared settings for every REA-Radio-DJ project. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>REA-Radio-DJ contributors</Authors>
    <Version>1.1.0</Version>
    <Company>ICT Holland (DVC-it)</Company>
    <Product>REA-Radio-DJ</Product>
    <Copyright>© 2026 ICT Holland (DVC-it) · GPL-3.0-or-later</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- BASS is not part of the repository. scripts/fetch-bass.ps1 puts the DLLs in /native;
       when they are there, copy them next to every executable and test assembly. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)native')">
    <None Include="$(MSBuildThisFileDirectory)native\*.dll" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- fpcalc (Chromaprint, LGPL) for AcoustID: scripts/fetch-fpcalc.ps1 puts it in /native. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)native\fpcalc.exe')">
    <None Include="$(MSBuildThisFileDirectory)native\fpcalc.exe" Link="fpcalc.exe"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
